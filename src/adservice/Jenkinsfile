pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            namespace 'jenkins'

            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-ci-agent
spec:
  serviceAccountName: jenkins

  containers:

  - name: gradle
    image: gradle:8.10.2-jdk21
    command:
    - sleep
    args:
    - 99d
    tty: true

  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.23.2-debug
    command:
    - sleep
    args:
    - 99d
    tty: true
'''
        }
    }

    options {
        timestamps()
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )
    }

    environment {
        SERVICE_NAME = 'adservice'
        SERVICE_DIR = 'src/adservice'

        AWS_REGION = 'ap-south-1'

        ECR_REGISTRY = '029678959141.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY = 'microservices-demo/adservice'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    echo "======================================"
                    echo "Service : ${SERVICE_NAME}"
                    echo "Commit  : ${GIT_COMMIT_SHORT}"
                    echo "======================================"
                }
            }
        }

        stage('Build & Test') {
    steps {
        container('gradle') {
            dir("${SERVICE_DIR}") {
                sh '''
                    chmod +x gradlew
                    ./gradlew clean test
                '''
            }
        }
    }

    post {
        always {
            script {
                def testReportDir = "${SERVICE_DIR}/build/test-results/test"

                if (fileExists(testReportDir)) {
                    junit(
                        testResults: "${testReportDir}/*.xml",
                        allowEmptyResults: true
                    )
                } else {
                    echo "No JUnit test reports found for ${SERVICE_NAME} (tests may be NO-SOURCE)"
                }
            }
        }
    }
}

        stage('Build & Push to ECR') {
            steps {
                container('kaniko') {

                    sh '''
                        /kaniko/executor \
                          --context=${WORKSPACE}/${SERVICE_DIR} \
                          --dockerfile=${WORKSPACE}/${SERVICE_DIR}/Dockerfile \
                          --destination=${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}
                    '''
                }
            }
        }
    }

    post {

        success {
            echo """
==============================================
CI PIPELINE SUCCESS
==============================================

Service : ${SERVICE_NAME}
Commit  : ${GIT_COMMIT_SHORT}

ECR Image:
${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}

==============================================
"""
        }

        failure {
            echo """
==============================================
CI PIPELINE FAILED
==============================================

Service : ${SERVICE_NAME}
Commit  : ${GIT_COMMIT_SHORT}

==============================================
"""
        }

        always {
            cleanWs()
        }
    }
}