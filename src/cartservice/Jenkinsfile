pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            namespace 'jenkins'

            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-ci-agent
spec:
  serviceAccountName: jenkins

  containers:

  - name: dotnet
    image: mcr.microsoft.com/dotnet/sdk:9.0
    command:
    - sleep
    args:
    - 99d
    tty: true

  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.23.2-debug
    command:
    - sleep
    args:
    - 99d
    tty: true
'''
        }
    }

    options {
        timestamps()
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )
    }

    environment {
        SERVICE_NAME = 'cartservice'
        SERVICE_DIR = 'src/cartservice'

        AWS_REGION = 'ap-south-1'

        ECR_REGISTRY = '029678959141.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY = 'microservices-demo/cartservice'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                script {
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    echo "======================================"
                    echo "Service : ${SERVICE_NAME}"
                    echo "Commit  : ${GIT_COMMIT_SHORT}"
                    echo "======================================"
                }
            }
        }


        stage('Build & Test') {
            steps {

                container('dotnet') {

                    dir("${SERVICE_DIR}") {

                        sh '''
                            dotnet --version

                            dotnet restore cartservice.sln

                            dotnet build cartservice.sln \
                                --configuration Release \
                                --no-restore

                            dotnet test cartservice.sln \
                                --configuration Release \
                                --no-build \
                                --logger "trx;LogFileName=test-results.trx"
                        '''
                    }
                }
            }

            post {
                always {
                    script {
                        def testResults = findFiles(
                            glob: "${SERVICE_DIR}/**/TestResults/*.trx"
                        )

                        if (testResults.length > 0) {
                            echo "Test result files found:"
                            testResults.each {
                                echo " - ${it.path}"
                            }
                        } else {
                            echo "No TRX test result files found."
                        }
                    }
                }
            }
        }


        stage('Build & Push to ECR') {
            steps {

                container('kaniko') {

                    sh '''
                        /kaniko/executor \
                          --context=${WORKSPACE}/${SERVICE_DIR} \
                          --dockerfile=${WORKSPACE}/${SERVICE_DIR}/Dockerfile \
                          --destination=${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}
                    '''
                }
            }
        }
    }


    post {

        success {
            echo """
==============================================
CI PIPELINE SUCCESS
==============================================

Service : ${SERVICE_NAME}
Commit  : ${GIT_COMMIT_SHORT}

ECR Image:
${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}

==============================================
"""
        }

        failure {
            echo """
==============================================
CI PIPELINE FAILED
==============================================

Service : ${SERVICE_NAME}
Commit  : ${GIT_COMMIT_SHORT}

Check Jenkins logs.

==============================================
"""
        }

        always {
            cleanWs()
        }
    }
}