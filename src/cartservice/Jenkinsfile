pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )
    }

    environment {
        SERVICE_NAME = 'cartservice'
        SERVICE_DIR = 'src/cartservice'

        GHCR_REGISTRY = 'ghcr.io'
        GHCR_OWNER = 'YOUR_GITHUB_USERNAME'
        GHCR_REPOSITORY = 'microservices-demo/cartservice'

        IMAGE_TAG = "${env.GIT_COMMIT}"

        SONARQUBE_SERVER = 'sonarqube'
    }

    stages {

        stage('Checkout') {
            agent {
                label 'linux-docker'
            }

            steps {
                checkout scm

                script {
                    env.SHORT_COMMIT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    echo "Building ${SERVICE_NAME}"
                    echo "Commit: ${SHORT_COMMIT}"
                }
            }
        }


        stage('Build & Test') {
            agent {
                label 'linux-docker'
            }

            steps {
                dir("${SERVICE_DIR}") {

                    sh '''
                        dotnet restore cartservice.sln

                        dotnet build cartservice.sln \
                            --configuration Release \
                            --no-restore

                        dotnet test cartservice.sln \
                            --configuration Release \
                            --no-build \
                            --logger "trx;LogFileName=test-results.trx"
                    '''
                }
            }

            post {
                always {
                    echo "Publishing test results"

                    junit(
                        testResults: "${SERVICE_DIR}/**/TestResults/*.xml",
                        allowEmptyResults: true
                    )
                }
            }
        }


        stage('SonarQube Analysis') {
            agent {
                label 'linux-docker'
            }

            steps {
                dir("${SERVICE_DIR}") {

                    withSonarQubeEnv("${SONARQUBE_SERVER}") {

                        sh '''
                            dotnet sonarscanner begin \
                                /k:"microservices-demo-cartservice" \
                                /d:sonar.host.url="$SONAR_HOST_URL"

                            dotnet build cartservice.sln \
                                --configuration Release

                            dotnet sonarscanner end
                        '''
                    }
                }
            }
        }


        stage('Quality Gate') {
            agent none

            steps {
                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }


        stage('Docker Build') {
            agent {
                label 'linux-docker'
            }

            steps {
                dir("${SERVICE_DIR}") {

                    sh '''
                        docker build \
                            -t ${GHCR_REGISTRY}/${GHCR_OWNER}/${GHCR_REPOSITORY}:${IMAGE_TAG} \
                            -t ${GHCR_REGISTRY}/${GHCR_OWNER}/${GHCR_REPOSITORY}:latest \
                            .
                    '''
                }
            }
        }


        stage('Security Scan') {
            agent {
                label 'linux-docker'
            }

            steps {

                sh '''
                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        ${GHCR_REGISTRY}/${GHCR_OWNER}/${GHCR_REPOSITORY}:${IMAGE_TAG}
                '''
            }
        }


        stage('GHCR Login') {
            agent {
                label 'linux-docker'
            }

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-container-registry',
                        usernameVariable: 'GHCR_USERNAME',
                        passwordVariable: 'GHCR_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "${GHCR_TOKEN}" | \
                        docker login ${GHCR_REGISTRY} \
                            --username "${GHCR_USERNAME}" \
                            --password-stdin
                    '''
                }
            }
        }


        stage('Push Image') {
            agent {
                label 'linux-docker'
            }

            steps {

                sh '''
                    docker push \
                        ${GHCR_REGISTRY}/${GHCR_OWNER}/${GHCR_REPOSITORY}:${IMAGE_TAG}

                    docker push \
                        ${GHCR_REGISTRY}/${GHCR_OWNER}/${GHCR_REPOSITORY}:latest
                '''
            }
        }
    }


    post {

        success {
            echo """
            ==============================================
            CI PIPELINE SUCCESS
            ==============================================

            Service : ${SERVICE_NAME}
            Commit  : ${SHORT_COMMIT}

            Image:
            ${GHCR_REGISTRY}/${GHCR_OWNER}/${GHCR_REPOSITORY}:${IMAGE_TAG}

            ==============================================
            """
        }

        failure {
            echo """
            ==============================================
            CI PIPELINE FAILED
            ==============================================

            Service : ${SERVICE_NAME}
            Commit  : ${SHORT_COMMIT}

            Check Jenkins logs.

            ==============================================
            """
        }

        always {
            cleanWs()
        }
    }
}