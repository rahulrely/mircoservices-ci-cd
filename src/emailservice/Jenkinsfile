pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins

  containers:
  - name: python
    image: python:3.12-alpine
    command:
    - sleep
    args:
    - 99d
    tty: true

  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.23.2-debug
    command:
    - sleep
    args:
    - 99d
    tty: true
'''
        }
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )
    }

    environment {
        SERVICE_NAME = 'emailservice'
        SERVICE_DIR = 'src/emailservice'

        AWS_REGION = 'ap-south-1'
        ECR_REGISTRY = '029678959141.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY = 'microservices-demo/emailservice'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    env.SHORT_COMMIT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    echo "======================================"
                    echo "Service : ${SERVICE_NAME}"
                    echo "Commit  : ${SHORT_COMMIT}"
                    echo "======================================"
                }
            }
        }

        stage('Build & Validate') {
            steps {
                container('python') {
                    dir("${SERVICE_DIR}") {
                        sh '''
                            set -e

                            echo "======================================"
                            echo "Python Build & Validate"
                            echo "======================================"

                            python --version
                            pip --version

                            test -f requirements.txt

                            python -m venv .venv
                            . .venv/bin/activate

                            pip install --upgrade pip
                            pip install -r requirements.txt

                            python -m py_compile \
                                email_server.py \
                                email_client.py \
                                logger.py \
                                demo_pb2.py \
                                demo_pb2_grpc.py

                            echo "Python validation successful."
                        '''
                    }
                }
            }
        }

        stage('Build & Push to ECR') {
            steps {
                container('kaniko') {
                    sh '''
                        set -e

                        cd "${WORKSPACE}/${SERVICE_DIR}"

                        echo "======================================"
                        echo "Building ${SERVICE_NAME}"
                        echo "Dockerfile: Dockerfile"
                        echo "Context: $(pwd)"
                        echo "Image Tag: ${IMAGE_TAG}"
                        echo "======================================"

                        test -f Dockerfile

                        /kaniko/executor \
                            --context="$(pwd)" \
                            --dockerfile="$(pwd)/Dockerfile" \
                            --destination="${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo """
            ==============================================
            CI PIPELINE SUCCESS
            ==============================================

            Service : ${SERVICE_NAME}
            Commit  : ${SHORT_COMMIT}

            ECR Image:
            ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}

            ==============================================
            """
        }

        failure {
            echo """
            ==============================================
            CI PIPELINE FAILED
            ==============================================

            Service : ${SERVICE_NAME}
            Commit  : ${SHORT_COMMIT}

            Check Jenkins logs.

            ==============================================
            """
        }
    }
}