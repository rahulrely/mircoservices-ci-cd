pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )
    }

    environment {
        SERVICE_NAME = 'loadgenerator'
        SERVICE_DIR = 'src/loadgenerator'

        AWS_REGION = 'ap-south-1'
        ECR_REGISTRY = '029678959141.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY = 'microservices-demo/loadgenerator'
    }

    stages {

        stage('CI') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: loadgenerator-ci
spec:
  serviceAccountName: jenkins

  containers:

  - name: python
    image: python:3.12.8-alpine
    command:
    - cat
    tty: true

  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.23.2-debug
    command:
    - /busybox/cat
    tty: true
    volumeMounts:
    - name: docker-config
      mountPath: /kaniko/.docker

  volumes:
  - name: docker-config
    emptyDir: {}
'''
                }
            }

            stages {

                stage('Checkout') {
                    steps {
                        checkout scm

                        script {
                            env.IMAGE_TAG = sh(
                                script: 'git rev-parse HEAD',
                                returnStdout: true
                            ).trim()

                            env.SHORT_COMMIT = sh(
                                script: 'git rev-parse --short HEAD',
                                returnStdout: true
                            ).trim()
                        }

                        echo "Building ${SERVICE_NAME}"
                        echo "Commit: ${SHORT_COMMIT}"
                    }
                }

                stage('Install Dependencies') {
                    steps {
                        container('python') {
                            dir("${SERVICE_DIR}") {
                                sh '''
                                    set -e

                                    python --version
                                    pip --version

                                    apk add --no-cache \
                                        gcc \
                                        g++ \
                                        musl-dev \
                                        make \
                                        linux-headers

                                    python -m venv .venv

                                    . .venv/bin/activate

                                    pip install --upgrade pip
                                    pip install -r requirements.txt
                                '''
                            }
                        }
                    }
                }

                stage('Validate') {
                    steps {
                        container('python') {
                            dir("${SERVICE_DIR}") {
                                sh '''
                                    set -e

                                    . .venv/bin/activate

                                    python -m py_compile locustfile.py

                                    echo "locustfile.py validation successful"
                                '''
                            }
                        }
                    }
                }

                stage('Docker Build & Push') {
                    steps {
                        container('kaniko') {
                            dir("${SERVICE_DIR}") {
                                sh '''
                                    set -e

                                    test -f Dockerfile

                                    /kaniko/executor \
                                        --context "$(pwd)" \
                                        --dockerfile "$(pwd)/Dockerfile" \
                                        --destination "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}" \
                                        --cache=true \
                                        --cache-repo "${ECR_REGISTRY}/${ECR_REPOSITORY}/cache"
                                '''
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo """
            ==============================================
            CI PIPELINE SUCCESS
            ==============================================

            Service : ${SERVICE_NAME}
            Commit  : ${SHORT_COMMIT}

            Image:
            ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}

            ==============================================
            """
        }

        failure {
            echo """
            ==============================================
            CI PIPELINE FAILED
            ==============================================

            Service : ${SERVICE_NAME}
            Commit  : ${SHORT_COMMIT}

            Check Jenkins logs.

            ==============================================
            """
        }
    }
}